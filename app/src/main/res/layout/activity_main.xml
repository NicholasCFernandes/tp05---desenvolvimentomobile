<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:titleTextColor="?attr/colorOnPrimary" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- A lista rola por baixo da toolbar (appbar_scrolling_view_behavior).
         O padding inferior grande evita que o botão + cubra o último item. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView_filmes"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="@dimen/espaco_pequeno"
        android:paddingTop="@dimen/espaco_pequeno"
        android:paddingEnd="@dimen/espaco_pequeno"
        android:paddingBottom="@dimen/padding_inferior_lista"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <!-- Heurística 1 (visibilidade do estado do sistema): lista vazia explica o que fazer -->
    <LinearLayout
        android:id="@+id/layout_vazio"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/espaco_grande"
        android:visibility="gone"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <ImageView
            android:layout_width="@dimen/tamanho_icone_vazio"
            android:layout_height="@dimen/tamanho_icone_vazio"
            android:alpha="0.5"
            android:contentDescription="@string/desc_icone_lista_vazia"
            android:src="@drawable/ic_filme_vazio"
            app:tint="?android:attr/textColorSecondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_medio"
            android:gravity="center"
            android:text="@string/texto_lista_vazia"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?android:attr/textColorSecondary" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_adicionar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/espaco_medio"
        android:contentDescription="@string/desc_adicionar_filme"
        android:src="@drawable/ic_add"
        app:backgroundTint="?attr/colorSecondary"
        app:tint="?attr/colorOnSecondary" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
