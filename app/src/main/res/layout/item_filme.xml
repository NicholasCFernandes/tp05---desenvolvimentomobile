<?xml version="1.0" encoding="utf-8"?>
<!-- Heurística 4 (consistência): todo item da lista usa o mesmo card.
     Medidas conforme o slide "CARDS" da aula: margem 8dp, raio 8dp, elevação 8dp,
     imagem ocupando 30% da largura do container. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/margem_card"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="@dimen/raio_card"
    app:cardElevation="@dimen/elevacao_card">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/espaco_pequeno">

        <!-- 30% da largura; "H,2:3" faz a altura ser calculada a partir da largura (pôster 2:3) -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imageView_fotoFilme"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/background_imagem_card"
            android:contentDescription="@string/desc_foto_filme"
            android:scaleType="centerCrop"
            app:layout_constraintDimensionRatio="H,2:3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.3"
            app:shapeAppearanceOverlay="@style/ImagemArredondada"
            tools:src="@drawable/ic_placeholder_filme" />

        <!-- Bloco de textos centralizado verticalmente em relação à foto -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/espaco_medio"
            android:gravity="center_vertical"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="@id/imageView_fotoFilme"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/imageView_fotoFilme"
            app:layout_constraintTop_toTopOf="@id/imageView_fotoFilme">

            <TextView
                android:id="@+id/textView_nomeFilme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/texto_nome_filme"
                android:textStyle="bold"
                tools:text="Nome do filme" />

            <RatingBar
                android:id="@+id/ratingBar_notaFilme"
                style="?attr/ratingBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_pequeno"
                android:isIndicator="true"
                android:numStars="5"
                android:progressBackgroundTint="@color/cinza_estrela_vazia"
                android:progressTint="@color/dourado"
                android:stepSize="0.5"
                tools:rating="4.5" />

            <TextView
                android:id="@+id/textView_notaFilme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="?android:attr/textColorSecondary"
                tools:text="4,5 / 5" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
